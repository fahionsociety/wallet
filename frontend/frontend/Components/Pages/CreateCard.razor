@page "/create-card"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http

<h1>Create Employee Card</h1>

<EditForm Model="card" OnValidSubmit="SubmitCard" FormName="CreateEmployeeCard">
    <div>
        <label>Voornaam</label>
        <InputText @bind-Value="card.EmployeeSurname" />
    </div>

    <div>
        <label>Achternaam</label>
        <InputText @bind-Value="card.EmployeeLastName" />
    </div>

    <div>
        <label>Personeelsnummer</label>
        <InputText @bind-Value="card.EmployeeNumber" />
    </div>

    <div>
        <label>Company</label>
        <InputSelect @bind-Value="card.Company">
            <option value="">Selecteer</option>
            <option value="ZEB">ZEB</option>
            <option value="PCR">PCR</option>
            <option value="TFS">TFS</option>
        </InputSelect>
    </div>

    <div>
        <label>Email</label>
        <InputText @bind-Value="card.EmployeeEmail" />
    </div>

    <div>
        <label>
            <InputCheckbox @bind-Value="card.PartnerCard" />
            Partner card
        </label>
    </div>

    <button type="submit">Create Card</button>

</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private CardRequest card = new();

    private string message = "";

    private async Task SubmitCard()
    {
        var response = await Http.PostAsJsonAsync(
            "http://localhost:5042/api/cards",
            card);

if (response.IsSuccessStatusCode)
{
    message = "Card successfully created.";
}
else
{
    var error = await response.Content.ReadAsStringAsync();

    message = $"Error {response.StatusCode}: {error}";
}
    }

    private class CardRequest
    {
        public string EmployeeSurname { get; set; } = "";
        public string EmployeeLastName { get; set; } = "";
        public string EmployeeNumber { get; set; } = "";
        public string Company { get; set; } = "";
        public string EmployeeEmail { get; set; } = "";
        public bool PartnerCard { get; set; }
    }
}