@page "/cards/create"

<h1>Create Card</h1>

<div class="card-form">

    <div>
        <label>Nameholder</label>
        <input @bind="nameholder" placeholder="Bieke Bellot" />
    </div>

    <div>
        <label>Personnel card number</label>
        <input @bind="personnelNumber" placeholder="123456" />
    </div>

    <div>
        <label>Company</label>
        <select @bind="company">
            <option value="">Select company</option>
            <option value="ZEB">ZEB</option>
            <option value="PCR">PCR</option>
            <option value="TFS">TFS</option>
        </select>
    </div>

    <div>
        <label>Email</label>
        <input type="email" @bind="email" placeholder="name@company.com" />
    </div>

    <div>
        <label>Partner card</label>
        <select @bind="isPartnerCard">
            <option value="false">No</option>
            <option value="true">Yes</option>
        </select>
    </div>

    <br />

    <button @onclick="CreateCard">
        Create Card
    </button>

</div>

@if (created)
{
    <hr />

    <h2>Card created</h2>

    <p><strong>Name:</strong> @nameholder</p>
    <p><strong>Personnel number:</strong> @personnelNumber</p>
    <p><strong>Company:</strong> @company</p>
    <p><strong>Email:</strong> @email</p>
    <p><strong>Partner card:</strong> @isPartnerCard</p>
}

@code {

    private string nameholder = "";
    private string personnelNumber = "";
    private string company = "";
    private string email = "";
    private string isPartnerCard = "false";

    private bool created = false;

    private void CreateCard()
    {
        created = true;
    }
}